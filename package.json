{
  "name": "ay-pi-workspace",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx 'src/**/*.test.ts'",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --external:@earendil-works/* --outfile=extension/ay-pi/dist/index.js && cp README.md extension/ay-pi/README.md"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "^22.19.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "~5.7"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
